{
  "name": "streamline-mcp",
  "version": "1.1.1",
  "description": "MCP server for Streamline - access your tasks, notes, tags, and workspaces",
  "main": "dist/index.js",
  "bin": {
    "streamline-mcp": "dist/index.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RosTeHeA/streamline-mcp.git"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "migrations/"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "mcp",
    "streamline",
    "tasks",
    "notes",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "embedded-postgres": "17.6.0-beta.15",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
